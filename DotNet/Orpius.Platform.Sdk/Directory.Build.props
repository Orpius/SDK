<Project>

	<!-- Centralized versioning -->
	<PropertyGroup>
		<!-- NuGet package version -->
		<Version>1.0.7-beta.1</Version>

		<Company Condition="'$(Company)' == ''">Orpius</Company>
		<Authors Condition="'$(Authors)' == ''">Orpius</Authors>
		
		<!-- Dynamic copyright target uses this -->
		<StartYear Condition="'$(StartYear)' == ''">2025</StartYear>

		<!-- Reproducible, source-linked packages -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!--<ContinuousIntegrationBuild Condition="'$(CI)' != ''">true</ContinuousIntegrationBuild>-->
		<Deterministic>true</Deterministic>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!--<PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>-->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!--<NeutralLanguage>en-GB</NeutralLanguage>-->

		<RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/Orpius/SDK</RepositoryUrl>
		<PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://orpius.com</PackageProjectUrl>
		<PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
	</PropertyGroup>

	<PropertyGroup>
		<PackageIcon>OrpiusLogoIconSquare128.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- MSBuildThisFileDirectory points to the folder 
		     that contains this props file (solution root). -->
		<None Include="$(MSBuildThisFileDirectory)Assets/OrpiusLogoIconSquare128.png"
		      Pack="true"
		      PackagePath="\" />
	</ItemGroup>

</Project>