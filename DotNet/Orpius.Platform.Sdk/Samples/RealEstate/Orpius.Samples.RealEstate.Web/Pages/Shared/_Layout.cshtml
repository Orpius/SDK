<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Orpius Real Estate Sample</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/Orpius.Samples.RealEstate.Web.styles.css" asp-append-version="true" />
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
			<div class="container">
				<a class="navbar-brand me-5" asp-area="" asp-page="/Index">Orpius Real Estate</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1 real-estate-nav">
						<li class="nav-item nav-cluster">
							<span class="nav-cluster-label">applicants</span>

							<a class="nav-cluster-link"
							   asp-area=""
							   asp-page="/Applicants/Index">
								View
							</a>

							<a class="nav-cluster-link"
							   asp-area=""
							   asp-page="/Applicants/Add">
								Add
							</a>
						</li>
						
						<li class="nav-separator" aria-hidden="true">|</li>

						<li class="nav-item nav-cluster">
							<span class="nav-cluster-label">listings</span>

							<a class="nav-cluster-link"
							   asp-area=""
							   asp-page="/Listings/Index">
								View
							</a>

							<a class="nav-cluster-link"
							   asp-area=""
							   asp-page="/Listings/Add">
								Add
							</a>
						</li>
					</ul>
				</div>
			</div>
		</nav>
	</header>
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2026 - Orpius
		</div>
	</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>