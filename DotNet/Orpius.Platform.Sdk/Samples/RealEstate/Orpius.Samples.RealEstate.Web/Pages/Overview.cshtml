@page

@{
	ViewData["Title"] = "Demo Overview";
}

<div class="overviewPage">
	<header class="overviewHeader">
		<div>
			<p class="eyebrow">Orpius SDK sample</p>
			<h1>Real Estate Flow</h1>
		</div>
	</header>

	<section class="overviewStage" aria-label="Animated overview of the real estate assistant flow">
		<div class="stageCaption">
			<span>Unstructured input</span>
			<span>Structured tools</span>
			<span>Business action</span>
		</div>

		<div class="diagramCanvas">
			<svg class="flowSvg" viewBox="0 0 1200 620" preserveAspectRatio="none" aria-hidden="true">
				<defs>
					<marker id="arrowHead" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
						<path d="M0,0 L0,6 L9,3 z" class="arrowHeadPath" />
					</marker>

					<filter id="tokenGlow">
						<feGaussianBlur stdDeviation="3.5" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>
				</defs>

				<path class="flowPath"
					  d="M 185 145 C 310 150, 390 230, 500 292"
					  marker-end="url(#arrowHead)" />

				<path class="flowPath"
					  d="M 620 292 C 700 220, 755 165, 810 160"
					  marker-end="url(#arrowHead)" />

				<path class="flowPath"
					  d="M 185 475 C 315 465, 390 385, 500 330"
					  marker-end="url(#arrowHead)" />

				<path class="flowPath"
					  d="M 620 330 C 700 392, 755 450, 810 460"
					  marker-end="url(#arrowHead)" />

				<path class="flowPath notifyPath"
					  d="M 625 310 C 745 310, 855 310, 960 310"
					  marker-end="url(#arrowHead)" />
			</svg>

			<div class="diagramNode inputNode applicantNode">
				<div class="nodeIcon">👤</div>
				<strong>Applicant</strong>
				<span>notes</span>
			</div>

			<div class="diagramNode dataNode applicantDataNode">
				<div class="nodeIcon">▦</div>
				<strong>Applicant DB</strong>
				<span>preferences</span>
			</div>

			<div class="diagramNode inputNode listingNode">
				<div class="nodeIcon">🏠</div>
				<strong>Listing</strong>
				<span>description</span>
			</div>

			<div class="diagramNode dataNode listingDataNode">
				<div class="nodeIcon">▦</div>
				<strong>Listing DB</strong>
				<span>property</span>
			</div>

			<div class="orpiusNode">
				<div class="orpiusRing"></div>
				<div class="orpiusCore">
					<span>✦</span>
					<strong>Orpius</strong>
					<small>extract · call tools · match</small>
				</div>
			</div>

			<div class="diagramNode notifyNode">
				<div class="nodeIcon">✉</div>
				<strong>Notify</strong>
				<span>agents</span>
			</div>
		</div>
	</section>

	<footer class="overviewFooter">
		<a asp-page="/Index">Full explanation</a>
	</footer>
</div>