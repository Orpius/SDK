@page "/"
@using Sample_AspNetCore_ProtobufNet.ToolRegistration
@rendermode InteractiveServer
@inject RegistrationUtility RegistrationUtility

<PageTitle>Home</PageTitle>

<h1>Orpius Sample for ASP.NET Core and Protobuf.NET</h1>

<p>Set the URL for the Orpius server instance.</p>

<div class="mb-5">
	<label>URL</label>
	<input @bind="urlInput" placeholder="Enter URL" class="form-control"/>
	<div class="text-muted mt-1">Current: @ApplicationState.ServerUrl</div>
</div>

<h2>Tools Registration Settings</h2>

<p>Registering as a tool provider means that your application will receive requests to use tools,
    which you define by decorating your classes with the Tool attribute. 
    See the FlightStatusChecker in this sample.
</p>
<p>If an operation in your space happens to make use of a tool, 
    Orpius will reach out to your application to use the tool.
</p>
<p>You can define your own applications that provide different tools for your Space.</p>

<div class="mb-3">
	<label>External ID</label>
	<input @bind="toolsExternalIdInput" placeholder="Enter External ID" class="form-control" />
	@if (!string.IsNullOrEmpty(toolsExternalIdError))
	{
		<div class="text-danger">@toolsExternalIdError</div>
	}
	<div class="text-muted mt-1">Current: @ApplicationState.ToolsRegistrationSettings.ExternalId</div>
</div>

<div class="mb-3">
	<label>Access Key</label>
	<input @bind="toolsAccessKeyInput" placeholder="Enter Access Key" class="form-control" />
	@if (!string.IsNullOrEmpty(toolsAccessKeyError))
	{
		<div class="text-danger">@toolsAccessKeyError</div>
	}
	<div class="text-muted mt-1">Current: @ApplicationState.ToolsRegistrationSettings.AccessKey</div>
</div>

<div class="mb-5">
	<button @onclick="ApplyToolsSettings" class="btn btn-primary" disabled="@registering">
		@(registering ? "Registering…" : "Apply Tools Registration Settings")
	</button>

	@if (!string.IsNullOrEmpty(registrationMessage))
	{
		<div class="mt-2 @(registrationSucceeded ? "text-success" : "text-danger")">
			@registrationMessage
		</div>
	}
</div>

<h2>Operation Settings</h2>

<div class="mb-3">
	<label>External ID</label>
	<input @bind="externalIdInput" placeholder="Enter External ID" class="form-control"/>
	@if (!string.IsNullOrEmpty(externalIdError))
	{
		<div class="text-danger">@externalIdError</div>
	}
	<div class="text-muted mt-1">Current: @ApplicationState.OperationsSettings.ExternalId</div>
</div>

<div class="mb-3">
	<label>Access Key</label>
	<input @bind="accessKeyInput" placeholder="Enter Access Key" class="form-control"/>
	@if (!string.IsNullOrEmpty(accessKeyError))
	{
		<div class="text-danger">@accessKeyError</div>
	}
	<div class="text-muted mt-1">Current: @ApplicationState.OperationsSettings.AccessKey</div>
</div>

<div class="mb-5">
	<button @onclick="ApplyOperationSettings" class="btn btn-primary">Apply Operation Settings</button>
</div>

<div class="mb-3"></div>

@code {
	string? urlInput;
	string? externalIdInput;
	string? accessKeyInput;

	string? externalIdError;
	string? accessKeyError;

	void ApplyOperationSettings()
	{
		if (!string.IsNullOrWhiteSpace(urlInput))
		{
			ApplicationState.ServerUrl = urlInput;
		}

		externalIdError = null;
		accessKeyError  = null;

		if (Guid.TryParse(externalIdInput, out Guid parsedExternalId) 
			&& parsedExternalId != Guid.Empty)
		{
			ApplicationState.OperationsSettings.ExternalId = parsedExternalId;
		}
		else if (!string.IsNullOrWhiteSpace(externalIdInput))
		{
			externalIdError = "Invalid GUID format for External ID.";
		}

		if (Guid.TryParse(accessKeyInput, out Guid parsedAccessKey) 
			&& parsedAccessKey != Guid.Empty)
		{
			ApplicationState.OperationsSettings.AccessKey = parsedAccessKey;
		}
		else if (!string.IsNullOrWhiteSpace(accessKeyInput))
		{
			accessKeyError = "Invalid GUID format for Access Key.";
		}
	}

	string? toolsExternalIdInput;
	string? toolsAccessKeyInput;

	string? toolsExternalIdError;
	string? toolsAccessKeyError;

	bool registering;
	bool registrationSucceeded;
	string? registrationMessage;

	async Task ApplyToolsSettings()
	{
		if (!string.IsNullOrWhiteSpace(urlInput))
		{
			ApplicationState.ServerUrl = urlInput;
		}

		toolsExternalIdError = null;
		toolsAccessKeyError  = null;

		if (Guid.TryParse(toolsExternalIdInput, out Guid parsedExternalId) 
			&& parsedExternalId != Guid.Empty)
		{
			ApplicationState.ToolsRegistrationSettings.ExternalId = parsedExternalId;
		}
		else if (!string.IsNullOrWhiteSpace(toolsExternalIdInput))
		{
			toolsExternalIdError = "Invalid GUID format for External ID.";
		}

		if (Guid.TryParse(toolsAccessKeyInput, out Guid parsedAccessKey) 
			&& parsedAccessKey != Guid.Empty)
		{
			ApplicationState.ToolsRegistrationSettings.AccessKey = parsedAccessKey;
		}
		else if (!string.IsNullOrWhiteSpace(toolsAccessKeyError))
		{
			toolsAccessKeyError = "Invalid GUID format for Access Key.";
		}

		registering         = true;
		registrationMessage = null;

		try
		{
			await RegistrationUtility.RegisterAsProviderAsync();

			registrationSucceeded = true;
			registrationMessage   = "Tools were registered successfully.";
		}
		catch (Exception ex)
		{
			registrationSucceeded = false;
			registrationMessage   = $"Registration failed: {ex.Message}";
		}
		finally
		{
			registering = false;
		}
	}
}